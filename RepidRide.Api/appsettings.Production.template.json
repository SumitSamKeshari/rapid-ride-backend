{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:YOUR_PROD_DB_HOST,1433;Database=RepidRideDB;User Id=YOUR_PROD_USER;Password=YOUR_PROD_PASSWORD;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;MultipleActiveResultSets=True;"
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_A_SECURE_64_BYTE_KEY_IN_PRODUCTION_ENV_MIN_512_BITS_LONG!",
    "Issuer": "https://api.rapidride.com",
    "Audience": "https://app.rapidride.com",
    "ExpirationInDays": 1
  },
  "RoutingSettings": {
    "GoogleMapsApiKey": "REPLACE_WITH_YOUR_PRODUCTION_GOOGLE_MAPS_KEY",
    "BaseFare": 3.00,
    "CostPerKm": 1.50,
    "CostPerMinute": 0.35
  }
}
